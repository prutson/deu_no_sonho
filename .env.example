# ─── Provedor de IA (compatível com OpenAI SDK) ────────────────────────────
# Exemplos:
#   DeepSeek:  AI_BASE_URL=https://api.deepseek.com  /  AI_MODEL=deepseek-chat
#   OpenAI:    AI_BASE_URL=https://api.openai.com/v1 /  AI_MODEL=gpt-4o-mini
#   Groq:      AI_BASE_URL=https://api.groq.com/openai/v1 / AI_MODEL=llama3-8b-8192
AI_API_KEY=sk-...
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── App ───────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DOMAIN=seudominio.com.br
# Defina como true para desenvolvimento local (libera CORS para localhost)
ALLOW_LOCALHOST=false

# ─── Analytics (opcional) ──────────────────────────────────────────────────
# Deixe em branco ou remova para desativar o Google Analytics 4
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Limites ───────────────────────────────────────────────────────────────
RATE_LIMIT_POR_DIA=3
MAX_CHARS_SONHO=500
MAX_MENSAGENS_HISTORICO=25
